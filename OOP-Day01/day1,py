# 29. Salary - HRA, DA and Gross Salary
# ==========================================

class Salary:
    def __init__(self, name, basic):
        self.name = name
        self.basic = basic

    def calculate(self):
        hra = self.basic * 0.20
        da = self.basic * 0.10
        gross = self.basic + hra + da

        print("Employee:", self.name)
        print("HRA:", hra)
        print("DA:", da)
        print("Gross Salary:", gross)

salary = Salary("Rahul", 30000)
salary.calculate()


